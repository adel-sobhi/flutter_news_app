rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /latest_articles/{docId} {
      allow read, write: if true;
    }

    match /metadata/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
